{
  "centerWindow": {
    "keybinding": "ctrl+alt+c"
  },
  "resizeWindow": {
    "keybinding": "f9",
    "windowSizePercentages": [
      {
        "width": 50.00,
        "height": 50.00,
        "x": 50.0,
        "y": 50.0
      },
      {
        "width": 75.00,
        "height": 75.00,
        "x": 50.0,
        "y": 50.0
      },
      {
        "width": 100.00,
        "height": 100.00,
        "x": 50.0,
        "y": 50.0
      }
    ]
  }
}
